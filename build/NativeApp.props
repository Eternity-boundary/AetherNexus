<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <RepositoryRoot>$(MSBuildThisFileDirectory)..\</RepositoryRoot>
    <OutDir>$(RepositoryRoot)artifacts\bin\$(MSBuildProjectName)\$(Platform)\$(Configuration)\</OutDir>
    <IntDir>$(RepositoryRoot)artifacts\obj\$(MSBuildProjectName)\$(Platform)\$(Configuration)\</IntDir>
    <GeneratedFilesDir>$(IntDir)Generated Files\</GeneratedFilesDir>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <LanguageStandard>stdcpp20</LanguageStandard>
      <AdditionalIncludeDirectories>$(ProjectDir);$(ProjectDir)Views;$(GeneratedFilesDir)Views;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <AdditionalOptions>%(AdditionalOptions) /utf-8</AdditionalOptions>
    </ClCompile>
  </ItemDefinitionGroup>
</Project>
