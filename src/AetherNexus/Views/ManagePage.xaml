<Page x:Class="AetherNexus.ManagePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:AetherNexus"
      Loaded="OnLoaded" Unloaded="OnUnloaded" ActualThemeChanged="OnThemeChanged"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
  <Page.Resources>
    <DataTemplate x:Key="ManageRowTemplate" x:DataType="local:ManageItem">
      <Grid Padding="8,10" ColumnSpacing="20">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="160"/></Grid.ColumnDefinitions>
        <StackPanel Spacing="4">
          <TextBlock Text="{x:Bind Title}" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis"/>
          <TextBlock Text="{x:Bind Subtitle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
        </StackPanel>
        <TextBlock Grid.Column="1" Text="{x:Bind Detail}" TextWrapping="Wrap" HorizontalAlignment="Right" TextAlignment="Right"/>
      </Grid>
    </DataTemplate>
  </Page.Resources>
  <Grid Margin="24,20" RowSpacing="12">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <StackPanel Spacing="4">
      <TextBlock x:Name="PageTitle" Style="{StaticResource TitleTextBlockStyle}"/>
      <TextBlock x:Uid="ManageIntro" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
    </StackPanel>
    <StackPanel Grid.Row="1" Spacing="8">
      <InfoBar x:Name="Notice" IsOpen="False" IsClosable="False" AutomationProperties.LiveSetting="Polite" AutomationProperties.AutomationId="ManageNotice"/>
      <Button x:Name="SettingsLink" x:Uid="ManageSettings" Click="OnSettings" Visibility="Collapsed" AutomationProperties.AutomationId="ManageSettings" HorizontalAlignment="Left"/>
      <HyperlinkButton x:Name="OfficialAdminLink" x:Uid="ManageAdminOfficialLink" NavigateUri="https://platform.openai.com/settings/organization/admin-keys" Visibility="Collapsed" AutomationProperties.AutomationId="ManageAdminOfficialLink" HorizontalAlignment="Left"/>
      <HyperlinkButton x:Name="AdminBugReportLink" x:Uid="ManageAdminBugReportLink" NavigateUri="https://community.openai.com/t/delete-v1-organization-admin-api-keys-key-id-returns-404-with-empty-body-get-on-the-same-id-returns-200/1411757" Visibility="Collapsed" AutomationProperties.AutomationId="ManageAdminBugReportLink" HorizontalAlignment="Left"/>
    </StackPanel>
    <StackPanel x:Name="Filters" Grid.Row="2" Spacing="10">
      <Grid ColumnSpacing="12">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <ComboBox x:Name="ProjectPicker" x:Uid="ManageProject" HorizontalAlignment="Stretch" SelectionChanged="OnFilter" AutomationProperties.AutomationId="ManageProject"/>
        <ComboBox x:Name="ViewPicker" Grid.Column="1" HorizontalAlignment="Stretch" SelectionChanged="OnFilter" AutomationProperties.AutomationId="ManageView"/>
      </Grid>
      <Grid x:Name="UsageDates" ColumnSpacing="12" Visibility="Collapsed">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <CalendarDatePicker x:Name="StartDate" x:Uid="ManageStartDate" HorizontalAlignment="Stretch" DateChanged="OnDateChanged" AutomationProperties.AutomationId="ManageStartDate"/>
        <CalendarDatePicker x:Name="EndDate" Grid.Column="1" x:Uid="ManageEndDate" HorizontalAlignment="Stretch" DateChanged="OnDateChanged" AutomationProperties.AutomationId="ManageEndDate"/>
      </Grid>
      <Grid x:Name="UsageOptions" ColumnSpacing="12" Visibility="Collapsed">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <ComboBox x:Name="GroupPicker" x:Uid="ManageGroup" HorizontalAlignment="Stretch" SelectionChanged="OnFilter" AutomationProperties.AutomationId="ManageGroup"/>
        <ComboBox x:Name="MetricPicker" Grid.Column="1" x:Uid="ManageMetric" HorizontalAlignment="Stretch" SelectionChanged="OnMetric" AutomationProperties.AutomationId="ManageMetric"/>
      </Grid>
    </StackPanel>
    <StackPanel Grid.Row="3" Spacing="8">
      <CommandBar DefaultLabelPosition="Right" HorizontalAlignment="Stretch" Background="Transparent" OverflowButtonVisibility="Auto">
        <AppBarButton x:Name="RefreshButton" x:Uid="ManageRefresh" Icon="Refresh" Click="OnRefresh" AutomationProperties.AutomationId="ManageRefresh"/>
        <AppBarButton x:Name="CancelButton" x:Uid="ManageCancel" Icon="Cancel" Click="OnCancel" IsEnabled="False" AutomationProperties.AutomationId="ManageCancel"/>
        <AppBarButton x:Name="CreateButton" x:Uid="ManageCreate" Icon="Add" Click="OnCreate" Visibility="Collapsed" AutomationProperties.AutomationId="ManageCreate"/>
        <AppBarButton x:Name="IssueButton" x:Uid="ManageIssue" Icon="Permissions" Click="OnIssue" Visibility="Collapsed" IsEnabled="False" AutomationProperties.AutomationId="ManageIssue"/>
        <AppBarButton x:Name="EditButton" x:Uid="ManageEdit" Icon="Edit" Click="OnEdit" Visibility="Collapsed" AutomationProperties.AutomationId="ManageEdit"/>
        <AppBarButton x:Name="RemoveButton" x:Uid="ManageRemove" Icon="Delete" Click="OnRemove" Visibility="Collapsed" AutomationProperties.AutomationId="ManageRemove"/>
        <AppBarButton x:Name="ExportButton" x:Uid="ManageExport" Icon="Save" Click="OnExport" Visibility="Collapsed" IsEnabled="False" AutomationProperties.AutomationId="ManageExport"/>
        <CommandBar.SecondaryCommands>
          <AppBarButton x:Name="OfficialButton" x:Uid="ManageOfficial" Icon="World" Click="OnOfficial" AutomationProperties.AutomationId="ManageOfficial"/>
        </CommandBar.SecondaryCommands>
      </CommandBar>
      <TextBlock x:Name="ScopeText" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
      <TextBlock x:Name="PageHint" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
      <ProgressBar x:Name="BusyProgress" IsIndeterminate="True" Visibility="Collapsed" AutomationProperties.Name="Loading"/>
    </StackPanel>
    <Grid Grid.Row="4" RowSpacing="12">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Border x:Name="UsageSummary" Padding="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Visibility="Collapsed">
        <StackPanel Spacing="8">
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Spacing="4"><TextBlock x:Name="MetricLabel"/><TextBlock x:Name="MetricValue" Text="—" Style="{StaticResource SubtitleTextBlockStyle}" AutomationProperties.AutomationId="ManageMetricTotal"/></StackPanel>
            <TextBlock x:Name="ChartRange" Grid.Column="1" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
          </Grid>
          <Canvas x:Name="UsageChart" Height="112" SizeChanged="OnChartSizeChanged" AutomationProperties.AutomationId="ManageChart" Background="Transparent" Tag="{ThemeResource AccentFillColorDefaultBrush}"/>
        </StackPanel>
      </Border>
      <Grid x:Name="CollectionArea" Grid.Row="1" RowSpacing="8">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <AutoSuggestBox x:Name="SearchBox" x:Uid="ManageSearch" TextChanged="OnSearch" QueryIcon="Find" AutomationProperties.AutomationId="ManageSearch"/>
        <Grid Grid.Row="1">
          <ListView x:Name="RecordsList" ItemTemplate="{StaticResource ManageRowTemplate}" SelectionMode="Single" SelectionChanged="OnSelection" HorizontalContentAlignment="Stretch" AutomationProperties.AutomationId="ManageRecords"/>
          <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12" MaxWidth="440">
            <FontIcon Glyph="&#xE8A5;" FontSize="32" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <TextBlock x:Name="EmptyText" TextWrapping="Wrap" TextAlignment="Center"/>
          </StackPanel>
        </Grid>
        <Expander Grid.Row="2" x:Uid="ManageDetails" AutomationProperties.AutomationId="ManageDetailsExpander" HorizontalAlignment="Stretch">
          <ScrollViewer MaxHeight="180" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
            <TextBlock x:Name="DetailText" IsTextSelectionEnabled="True" TextWrapping="Wrap" FontFamily="Consolas" Margin="8" AutomationProperties.AutomationId="ManageDetail"/>
          </ScrollViewer>
        </Expander>
      </Grid>
    </Grid>
  </Grid>
</Page>
