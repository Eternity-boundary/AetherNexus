<Page x:Class="AetherNexus.PlaceholderPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Padding="32,24,32,32" RowSpacing="24">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
    <TextBlock x:Name="PageTitle" Style="{StaticResource TitleTextBlockStyle}" />
    <Border Grid.Row="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
            CornerRadius="{ThemeResource OverlayCornerRadius}">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16" Margin="24" MaxWidth="440">
        <FontIcon Glyph="&#xE7C3;" FontSize="40" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
        <TextBlock x:Uid="PlaceholderTitle" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" />
        <TextBlock x:Uid="PlaceholderBody" TextWrapping="Wrap" TextAlignment="Center"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
      </StackPanel>
    </Border>
  </Grid>
</Page>
