<Page
    x:Class="AetherNexus.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Loaded="OnLoaded"
    Unloaded="OnUnloaded">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled">
        <StackPanel
            MaxWidth="1000"
            Margin="32,24,32,32"
            HorizontalAlignment="Stretch"
            Spacing="24">
            <StackPanel Spacing="8">
                <TextBlock x:Uid="SettingsTitle" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock
                    x:Uid="SettingsIntro"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap" />
            </StackPanel>
            <InfoBar
                x:Name="Feedback"
                AutomationProperties.AutomationId="SettingsFeedback"
                AutomationProperties.LiveSetting="Polite"
                IsClosable="True"
                IsOpen="False" />
            <Border
                Padding="24"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{ThemeResource OverlayCornerRadius}">
                <StackPanel Spacing="12">
                    <TextBlock x:Uid="AppearanceTitle" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock x:Uid="AppearanceDescription" Style="{StaticResource SecondaryTextStyle}" />
                    <ComboBox
                        x:Name="ThemePicker"
                        x:Uid="ThemePicker"
                        MinWidth="200"
                        AutomationProperties.AutomationId="SettingsTheme"
                        SelectionChanged="OnThemeSelectionChanged">
                        <ComboBoxItem x:Uid="ThemeSystem" />
                        <ComboBoxItem x:Uid="ThemeLight" />
                        <ComboBoxItem x:Uid="ThemeDark" />
                    </ComboBox>
                </StackPanel>
            </Border>
            <Border
                Padding="24"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{ThemeResource OverlayCornerRadius}">
                <StackPanel Spacing="12">
                    <TextBlock x:Uid="BudgetTitle" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock x:Uid="BudgetDescription" Style="{StaticResource SecondaryTextStyle}" />
                    <ToggleSwitch
                        x:Name="BudgetEnabled"
                        x:Uid="BudgetEnabled"
                        AutomationProperties.AutomationId="BudgetEnabled"
                        Toggled="OnBudgetToggled" />
                    <NumberBox
                        x:Name="BudgetAmount"
                        x:Uid="BudgetAmount"
                        Width="240"
                        HorizontalAlignment="Left"
                        AutomationProperties.AutomationId="BudgetAmount"
                        IsEnabled="False"
                        Maximum="1000000000"
                        Minimum="0.01"
                        SpinButtonPlacementMode="Compact" />
                    <Button
                        x:Uid="SaveBudgetButton"
                        HorizontalAlignment="Left"
                        AutomationProperties.AutomationId="SaveBudget"
                        Click="OnSaveBudget" />
                </StackPanel>
            </Border>
            <StackPanel Spacing="8">
                <TextBlock x:Uid="CredentialsTitle" Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBlock x:Uid="CredentialsDescription" Style="{StaticResource SecondaryTextStyle}" />
            </StackPanel>
            <StackPanel x:Name="CredentialControls" Spacing="16">
                <Border
                    Padding="24"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{ThemeResource OverlayCornerRadius}">
                    <StackPanel Spacing="12">
                        <TextBlock x:Uid="ModelKeyTitle" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock x:Uid="ModelKeyDescription" Style="{StaticResource SecondaryTextStyle}" />
                        <TextBlock
                            x:Name="ModelStatus"
                            AutomationProperties.LiveSetting="Polite"
                            Style="{StaticResource CaptionTextBlockStyle}" />
                        <PasswordBox
                            x:Name="ModelKeyInput"
                            x:Uid="ModelKeyInput"
                            AutomationProperties.AutomationId="ModelKeyInput"
                            MaxLength="1281"
                            PasswordChanged="OnPasswordChanged"
                            PasswordRevealMode="Hidden" />
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Button
                                x:Name="SaveModelButton"
                                x:Uid="SaveModelButton"
                                AutomationProperties.AutomationId="SaveModelKey"
                                Click="OnSaveClick"
                                IsEnabled="False"
                                Style="{StaticResource AccentButtonStyle}"
                                Tag="model" />
                            <Button
                                x:Name="RemoveModelButton"
                                x:Uid="RemoveModelButton"
                                AutomationProperties.AutomationId="RemoveModelKey"
                                Click="OnRemoveClick"
                                IsEnabled="False"
                                Tag="model" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border
                    Padding="24"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{ThemeResource OverlayCornerRadius}">
                    <StackPanel Spacing="12">
                        <TextBlock x:Uid="AdminKeyTitle" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock x:Uid="AdminKeyDescription" Style="{StaticResource SecondaryTextStyle}" />
                        <TextBlock
                            x:Name="AdminStatus"
                            AutomationProperties.LiveSetting="Polite"
                            Style="{StaticResource CaptionTextBlockStyle}" />
                        <PasswordBox
                            x:Name="AdminKeyInput"
                            x:Uid="AdminKeyInput"
                            AutomationProperties.AutomationId="AdminKeyInput"
                            MaxLength="1281"
                            PasswordChanged="OnPasswordChanged"
                            PasswordRevealMode="Hidden" />
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Button
                                x:Name="SaveAdminButton"
                                x:Uid="SaveAdminButton"
                                AutomationProperties.AutomationId="SaveAdminKey"
                                Click="OnSaveClick"
                                IsEnabled="False"
                                Style="{StaticResource AccentButtonStyle}"
                                Tag="admin" />
                            <Button
                                x:Name="RemoveAdminButton"
                                x:Uid="RemoveAdminButton"
                                AutomationProperties.AutomationId="RemoveAdminKey"
                                Click="OnRemoveClick"
                                IsEnabled="False"
                                Tag="admin" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
            <InfoBar
                x:Uid="CredentialSafetyNotice"
                IsClosable="False"
                IsOpen="True"
                Severity="Informational" />
        </StackPanel>
    </ScrollViewer>
</Page>
