<Page x:Class="AetherNexus.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Loaded="OnLoaded" Unloaded="OnUnloaded">
  <ScrollViewer HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="32,24,32,32" Spacing="24" MaxWidth="1000" HorizontalAlignment="Stretch">
      <StackPanel Spacing="8">
        <TextBlock x:Uid="SettingsTitle" Style="{StaticResource TitleTextBlockStyle}" />
        <TextBlock x:Uid="SettingsIntro" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
      </StackPanel>
      <InfoBar x:Name="Feedback" IsClosable="True" IsOpen="False" AutomationProperties.LiveSetting="Polite"
               AutomationProperties.AutomationId="SettingsFeedback" />
      <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
              BorderThickness="1" CornerRadius="{ThemeResource OverlayCornerRadius}" Padding="24">
        <StackPanel Spacing="12">
          <TextBlock x:Uid="AppearanceTitle" Style="{StaticResource SubtitleTextBlockStyle}" />
          <TextBlock x:Uid="AppearanceDescription" Style="{StaticResource SecondaryTextStyle}" />
          <ComboBox x:Name="ThemePicker" x:Uid="ThemePicker" MinWidth="200" SelectionChanged="OnThemeSelectionChanged"
                    AutomationProperties.AutomationId="SettingsTheme">
            <ComboBoxItem x:Uid="ThemeSystem" />
            <ComboBoxItem x:Uid="ThemeLight" />
            <ComboBoxItem x:Uid="ThemeDark" />
          </ComboBox>
        </StackPanel>
      </Border>
      <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
              BorderThickness="1" CornerRadius="{ThemeResource OverlayCornerRadius}" Padding="24">
        <StackPanel Spacing="12">
          <TextBlock x:Uid="BudgetTitle" Style="{StaticResource SubtitleTextBlockStyle}" />
          <TextBlock x:Uid="BudgetDescription" Style="{StaticResource SecondaryTextStyle}" />
          <ToggleSwitch x:Name="BudgetEnabled" x:Uid="BudgetEnabled" Toggled="OnBudgetToggled" AutomationProperties.AutomationId="BudgetEnabled" />
          <NumberBox x:Name="BudgetAmount" x:Uid="BudgetAmount" Minimum="0.01" Maximum="1000000000" SpinButtonPlacementMode="Compact"
                     Width="240" HorizontalAlignment="Left" IsEnabled="False" AutomationProperties.AutomationId="BudgetAmount" />
          <Button x:Uid="SaveBudgetButton" Click="OnSaveBudget" HorizontalAlignment="Left" AutomationProperties.AutomationId="SaveBudget" />
        </StackPanel>
      </Border>
      <StackPanel Spacing="8">
        <TextBlock x:Uid="CredentialsTitle" Style="{StaticResource SubtitleTextBlockStyle}" />
        <TextBlock x:Uid="CredentialsDescription" Style="{StaticResource SecondaryTextStyle}" />
      </StackPanel>
      <StackPanel x:Name="CredentialControls" Spacing="16">
        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="{ThemeResource OverlayCornerRadius}" Padding="24">
          <StackPanel Spacing="12">
            <TextBlock x:Uid="ModelKeyTitle" Style="{StaticResource BodyStrongTextBlockStyle}" />
            <TextBlock x:Uid="ModelKeyDescription" Style="{StaticResource SecondaryTextStyle}" />
            <TextBlock x:Name="ModelStatus" Style="{StaticResource CaptionTextBlockStyle}" AutomationProperties.LiveSetting="Polite" />
            <PasswordBox x:Name="ModelKeyInput" x:Uid="ModelKeyInput" PasswordRevealMode="Hidden" MaxLength="1281"
                         PasswordChanged="OnPasswordChanged" AutomationProperties.AutomationId="ModelKeyInput" />
            <StackPanel Orientation="Horizontal" Spacing="12">
              <Button x:Name="SaveModelButton" x:Uid="SaveModelButton" Tag="model" Style="{StaticResource AccentButtonStyle}"
                      Click="OnSaveClick" IsEnabled="False" AutomationProperties.AutomationId="SaveModelKey" />
              <Button x:Name="RemoveModelButton" x:Uid="RemoveModelButton" Tag="model" Click="OnRemoveClick"
                      IsEnabled="False" AutomationProperties.AutomationId="RemoveModelKey" />
            </StackPanel>
          </StackPanel>
        </Border>
        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="{ThemeResource OverlayCornerRadius}" Padding="24">
          <StackPanel Spacing="12">
            <TextBlock x:Uid="AdminKeyTitle" Style="{StaticResource BodyStrongTextBlockStyle}" />
            <TextBlock x:Uid="AdminKeyDescription" Style="{StaticResource SecondaryTextStyle}" />
            <TextBlock x:Name="AdminStatus" Style="{StaticResource CaptionTextBlockStyle}" AutomationProperties.LiveSetting="Polite" />
            <PasswordBox x:Name="AdminKeyInput" x:Uid="AdminKeyInput" PasswordRevealMode="Hidden" MaxLength="1281"
                         PasswordChanged="OnPasswordChanged" AutomationProperties.AutomationId="AdminKeyInput" />
            <StackPanel Orientation="Horizontal" Spacing="12">
              <Button x:Name="SaveAdminButton" x:Uid="SaveAdminButton" Tag="admin" Style="{StaticResource AccentButtonStyle}"
                      Click="OnSaveClick" IsEnabled="False" AutomationProperties.AutomationId="SaveAdminKey" />
              <Button x:Name="RemoveAdminButton" x:Uid="RemoveAdminButton" Tag="admin" Click="OnRemoveClick"
                      IsEnabled="False" AutomationProperties.AutomationId="RemoveAdminKey" />
            </StackPanel>
          </StackPanel>
        </Border>
      </StackPanel>
      <InfoBar x:Uid="CredentialSafetyNotice" IsOpen="True" IsClosable="False" Severity="Informational" />
    </StackPanel>
  </ScrollViewer>
</Page>
