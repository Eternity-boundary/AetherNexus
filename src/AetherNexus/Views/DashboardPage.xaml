<Page
    x:Class="AetherNexus.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    ActualThemeChanged="OnThemeChanged"
    Loaded="OnLoaded"
    Unloaded="OnUnloaded">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled">
        <StackPanel
            x:Name="RootPanel"
            Margin="32,24,16,32"
            Spacing="24">
            <StackPanel Margin="0,0,16,0" Spacing="8">
                <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Dashboard" />
                <TextBlock
                    x:Uid="DashboardIntro"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource BodyTextBlockStyle}"
                    TextWrapping="Wrap" />
            </StackPanel>
            <Grid
                Margin="0,0,16,0"
                ColumnSpacing="12"
                RowSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ComboBox
                    x:Name="ProjectPicker"
                    x:Uid="ProjectPicker"
                    Grid.ColumnSpan="2"
                    HorizontalAlignment="Stretch"
                    AutomationProperties.AutomationId="DashboardProject"
                    IsTextSearchEnabled="True"
                    SelectionChanged="OnProjectChanged" />
                <ComboBox
                    x:Name="RangePicker"
                    x:Uid="RangePicker"
                    Grid.Row="1"
                    Width="172"
                    AutomationProperties.AutomationId="DashboardRange"
                    SelectedIndex="0"
                    SelectionChanged="OnRangeChanged">
                    <ComboBoxItem x:Uid="LastSevenDays" />
                    <ComboBoxItem x:Uid="LastThirtyDays" />
                </ComboBox>
                <Button
                    x:Name="RefreshButton"
                    x:Uid="DashboardRefresh"
                    Grid.Row="1"
                    Grid.Column="1"
                    VerticalAlignment="Bottom"
                    AutomationProperties.AutomationId="DashboardRefresh"
                    Click="OnRefresh">
                    <SymbolIcon Symbol="Refresh" />
                </Button>
            </Grid>
            <TextBlock
                x:Name="ProjectScopeLabel"
                Margin="0,-12,16,0"
                Style="{StaticResource SecondaryTextStyle}" />
            <InfoBar
                x:Name="ProjectNotice"
                Margin="0,0,16,0"
                AutomationProperties.AutomationId="DashboardProjectNotice"
                AutomationProperties.LiveSetting="Polite"
                IsClosable="False"
                IsOpen="False" />
            <ProgressRing
                x:Name="LoadingRing"
                Width="24"
                Height="24"
                HorizontalAlignment="Left"
                AutomationProperties.AutomationId="DashboardLoading"
                IsActive="False"
                Visibility="Collapsed" />
            <InfoBar
                x:Name="DataNotice"
                Margin="0,0,16,0"
                AutomationProperties.LiveSetting="Polite"
                IsClosable="False"
                IsOpen="False" />
            <Button
                x:Name="SettingsGuidance"
                x:Uid="DashboardOpenSettings"
                HorizontalAlignment="Left"
                AutomationProperties.AutomationId="DashboardOpenSettings"
                Click="OnOpenSettings"
                Style="{StaticResource AccentButtonStyle}"
                Visibility="Collapsed" />
            <Grid x:Name="CardsGrid" SizeChanged="OnCardsSizeChanged">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border x:Name="TokensCard" Style="{StaticResource MetricCardStyle}">
                    <Grid RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock x:Uid="TotalTokens" Style="{StaticResource MetricLabelStyle}" />
                            <TextBlock x:Name="TokensValue" Style="{StaticResource MetricValueStyle}" />
                        </StackPanel>
                        <Canvas
                            x:Name="TokensChart"
                            Grid.Row="1"
                            Height="76"
                            VerticalAlignment="Bottom"
                            IsHitTestVisible="False"
                            Tag="{ThemeResource TokenChartBrush}" />
                        <StackPanel
                            Grid.Row="2"
                            Orientation="Horizontal"
                            Spacing="16">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Ellipse
                                    Width="6"
                                    Height="6"
                                    Fill="{ThemeResource TokenChartBrush}" />
                                <TextBlock x:Uid="InputLegend" Style="{StaticResource SecondaryTextStyle}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Ellipse
                                    x:Name="OutputLegendMarker"
                                    Width="6"
                                    Height="6"
                                    Fill="{ThemeResource OutputChartBrush}" />
                                <TextBlock x:Uid="OutputLegend" Style="{StaticResource SecondaryTextStyle}" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>
                <Border
                    x:Name="CompletionsCard"
                    Grid.Column="1"
                    Style="{StaticResource MetricCardStyle}">
                    <Grid RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock x:Uid="CompletionsRequests" Style="{StaticResource MetricLabelStyle}" />
                            <TextBlock x:Name="CompletionsValue" Style="{StaticResource MetricValueStyle}" />
                        </StackPanel>
                        <Canvas
                            x:Name="CompletionsChart"
                            Grid.Row="1"
                            Height="76"
                            VerticalAlignment="Bottom"
                            IsHitTestVisible="False"
                            Tag="{ThemeResource CacheChartBrush}" />
                        <TextBlock
                            x:Uid="RequestsPerDay"
                            Grid.Row="2"
                            Style="{StaticResource SecondaryTextStyle}" />
                    </Grid>
                </Border>
                <Border
                    x:Name="CacheCard"
                    Grid.Column="2"
                    Style="{StaticResource MetricCardStyle}">
                    <Grid RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock x:Uid="CacheRatio" Style="{StaticResource MetricLabelStyle}" />
                            <TextBlock x:Name="CacheValue" Style="{StaticResource MetricValueStyle}" />
                        </StackPanel>
                        <Canvas
                            x:Name="CacheChart"
                            Grid.Row="1"
                            Height="76"
                            VerticalAlignment="Bottom"
                            IsHitTestVisible="False"
                            Tag="{ThemeResource CacheChartBrush}" />
                        <TextBlock
                            x:Uid="CacheDefinition"
                            Grid.Row="2"
                            Style="{StaticResource SecondaryTextStyle}" />
                    </Grid>
                </Border>
                <Border
                    x:Name="SpendCard"
                    Grid.Row="1"
                    Style="{StaticResource MetricCardStyle}">
                    <Grid RowSpacing="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock x:Uid="MonthSpend" Style="{StaticResource MetricLabelStyle}" />
                            <TextBlock x:Name="SpendValue" Style="{StaticResource MetricValueStyle}" />
                        </StackPanel>
                        <StackPanel
                            Grid.Row="1"
                            VerticalAlignment="Bottom"
                            Spacing="10">
                            <FontIcon
                                HorizontalAlignment="Left"
                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                Glyph="&#xE787;" />
                            <TextBlock x:Uid="CostDataHint" Style="{StaticResource SecondaryTextStyle}" />
                            <TextBlock x:Uid="LocalBudgetLabel" Style="{StaticResource SecondaryTextStyle}" />
                            <ProgressBar
                                x:Name="BudgetProgress"
                                AutomationProperties.AutomationId="LocalBudgetProgress"
                                Maximum="100"
                                Visibility="Collapsed" />
                            <TextBlock x:Name="BudgetValue" Style="{StaticResource SecondaryTextStyle}" />
                        </StackPanel>
                        <TextBlock
                            x:Uid="SpendDefinition"
                            Grid.Row="2"
                            Style="{StaticResource SecondaryTextStyle}" />
                    </Grid>
                </Border>
                <Border
                    x:Name="TodayCard"
                    Grid.Row="1"
                    Grid.Column="1"
                    Style="{StaticResource MetricCardStyle}">
                    <Grid RowSpacing="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock x:Uid="TodayTokens" Style="{StaticResource MetricLabelStyle}" />
                            <TextBlock x:Name="TodayValue" Style="{StaticResource MetricValueStyle}" />
                        </StackPanel>
                        <StackPanel
                            Grid.Row="1"
                            VerticalAlignment="Center"
                            Spacing="8">
                            <FontIcon
                                HorizontalAlignment="Left"
                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                Glyph="&#xE9D9;" />
                            <TextBlock x:Uid="TodayDefinition" Style="{StaticResource SecondaryTextStyle}" />
                        </StackPanel>
                        <TextBlock
                            x:Uid="TodayPeriod"
                            Grid.Row="2"
                            Style="{StaticResource SecondaryTextStyle}" />
                    </Grid>
                </Border>
                <Border
                    x:Name="CachedTokensCard"
                    Grid.Row="1"
                    Grid.Column="2"
                    Style="{StaticResource MetricCardStyle}">
                    <Grid RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock x:Uid="CachedTokens" Style="{StaticResource MetricLabelStyle}" />
                            <TextBlock x:Name="CachedTokensValue" Style="{StaticResource MetricValueStyle}" />
                        </StackPanel>
                        <Canvas
                            x:Name="CachedTokensChart"
                            Grid.Row="1"
                            Height="76"
                            VerticalAlignment="Bottom"
                            IsHitTestVisible="False"
                            Tag="{ThemeResource RequestChartBrush}" />
                        <TextBlock
                            x:Uid="CachedTokensDefinition"
                            Grid.Row="2"
                            Style="{StaticResource SecondaryTextStyle}" />
                    </Grid>
                </Border>
            </Grid>
            <Grid Margin="0,-12,16,0" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    x:Name="DateRangeLabel"
                    Style="{StaticResource SecondaryTextStyle}"
                    TextWrapping="Wrap" />
                <TextBlock
                    x:Name="DataStatus"
                    Grid.Column="1"
                    AutomationProperties.LiveSetting="Polite"
                    Style="{StaticResource SecondaryTextStyle}" />
            </Grid>
            <Border
                Margin="0,0,16,0"
                Padding="24"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{ThemeResource OverlayCornerRadius}">
                <StackPanel Spacing="8">
                    <TextBlock x:Uid="DataScopeTitle" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock x:Uid="DataScopeBody" Style="{StaticResource SecondaryTextStyle}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
